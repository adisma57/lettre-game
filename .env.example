# Copie vers .env pour le dev local (npm run server).
# Sur Vercel : Project Settings → Environment Variables → DATABASE_URL
#
# Sans DATABASE_URL en local : le serveur utilise une base en mémoire
# (données perdues au redémarrage). En production / sur Vercel, DATABASE_URL est obligatoire.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Optionnel : origines CORS séparées par des virgules (défaut : localhost + URL Vercel)
# CORS_ORIGIN=http://localhost:5173,https://ton-domaine.com

# Vercel (Node serverless + Hono + POST JSON) : défini aussi dans vercel.json
# NODEJS_HELPERS=0
